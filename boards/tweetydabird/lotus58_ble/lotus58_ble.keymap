#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
	keymap {
		compatible = "zmk,keymap";

        	default_layer {
            		bindings = <
			&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5			   &kp N6     &kp N7   &kp N8    &kp N9  &kp N0   &kp BSPC
			&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T				   &kp Y      &kp U    &kp I     &kp O   &kp P    &kp BSLH
			&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G 			   &kp H      &kp J    &kp K     &kp L   &kp SCLN &kp ENTER
			&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B      &kp LBKT    &kp RBKT  &kp N      &kp M    &kp COMMA &kp DOT &kp FSLH &kp RCTRL
			                        &kp LGUI &kp LALT &bt BT_CLR &kp SPACE   &kp SPACE &bt BT_CLR &kp BSPC &kp LALT
            		>;
		};
	};
};
