#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h> // Needed for bluetooth keybinds
#include <dt-bindings/zmk/ext_power.h> // Needed for the ability to switch off power to the underglow LEDs. Doesn't work right now, see _zmk.dtsi

/ {
	keymap {
		compatible = "zmk,keymap";

        	default_layer {
			bindings = <
				&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5					   &kp N6     &kp N7   &kp N8    &kp N9  &kp N0   &kp BSPC
				&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T						   &kp Y      &kp U    &kp I     &kp O   &kp P    &kp BSLH
				&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G 					   &kp H      &kp J    &kp K     &kp L   &kp SCLN &kp ENTER
				&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B      &ext_power EP_TOG   &ext_power EP_TOG &kp N      &kp M    &kp COMMA &kp DOT &kp FSLH &kp RCTRL
							&kp LGUI &kp LALT &bt BT_CLR &kp SPACE		 &kp SPACE	   &bt BT_CLR &kp BSPC &kp LALT
			>;
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
				&inc_dec_kp PG_UP PG_DN
			>;
		};
	};
};
