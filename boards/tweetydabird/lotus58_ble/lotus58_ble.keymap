#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h> // Needed for Bluetooth keybinds.
#include <dt-bindings/zmk/rgb.h> // Needed for controlling the underglow LEDs.
//#include <dt-bindings/zmk/ext_power.h> // Needed for the ability to switch off power to the underglow LEDs. Doesn't work right now, see lotus58_ble_zmk.dtsi file.

/ {
	keymap {
		compatible = "zmk,keymap";

		default-layer {
			display-name = "Base";
			bindings = <
				&kp ESC   &kp N1 &kp N2 &kp N3   &kp N4   &kp N5                        &kp N6 &kp N7   &kp N8    &kp N9  &kp N0   &kp GRAVE
				&kp TAB   &kp Q  &kp W  &kp E    &kp R    &kp T                         &kp Y  &kp U    &kp I     &kp O   &kp P    &kp MINUS
				&kp LSHFT &kp A  &kp S  &kp D    &kp F    &kp G                         &kp H  &kp J    &kp K     &kp L   &kp SEMI &kp SQT
				&kp LCTRL &kp Z  &kp X  &kp C    &kp V    &kp B  &kp C_MUTE   &kp C_PP  &kp N  &kp M    &kp COMMA &kp DOT &kp FSLH &kp RSHFT
				                        &kp LALT &kp LGUI &mo 1  &kp SPACE    &kp ENTER &mo 2  &kp BSPC &kp RGUI
			>;
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
				&inc_dec_kp C_NEXT C_PREV
			>;
		};

		lower {
			display-name = "Lower";
			bindings = <
				&studio_unlock &rgb_ug RGB_EFF &rgb_ug RGB_SAI &rgb_ug RGB_SAD &rgb_ug RGB_SPI &rgb_ug RGB_SPD                              &trans    &trans    &trans    &trans   &trans   &trans
				&kp F1         &kp F2          &kp F3          &kp F4          &kp F5          &kp F6                                      &kp F7    &kp F8    &kp F9    &kp F10  &kp F11  &kp F12
				&kp GRAVE      &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT                                   &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp TILDE
				&trans         &trans          &trans          &trans          &trans          &kp LBKT        &rgb_ug RGB_TOG   &trans    &kp RBKT  &kp UNDER &kp PLUS  &kp LBRC &kp RBRC &kp PIPE
				                                               &trans          &trans          &trans          &trans            &trans    &trans    &trans    &trans
			>;
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
				&inc_dec_kp C_NEXT C_PREV
			>;
		};

		raise {
			display-name = "Raise";
			bindings = <
				&bt BT_CLR &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                 &trans      &trans       &trans       &trans   &trans    &trans
				&kp GRAVE  &kp N1       &kp N2       &kp N3        &kp N4        &kp N5                       &kp N6      &kp N7       &kp N8       &kp N9   &kp N0    &trans
				&kp F1     &kp F2       &kp F3       &kp F4        &kp F5        &kp F6                       &trans      &kp LEFT     &kp DOWN     &kp UP   &kp RIGHT &trans
				&kp F7     &kp F8       &kp F9       &kp F10       &kp F11       &kp F12      &trans   &trans &kp KP_PLUS &kp KP_MINUS &kp KP_EQUAL &kp LBKT &kp RBKT  &kp BSLH
				                                     &trans        &trans        &trans       &trans   &trans &trans      &trans       &trans
			>;
			sensor-bindings = <
				&inc_dec_kp C_VOL_UP C_VOL_DN
				&inc_dec_kp C_NEXT C_PREV
			>;
		};
	};
};
