&pinctrl {

  // Enables SPI on pin P0.05 for the RBG LEDs
  spi3_default: spi3_default {
    group1 {
      psels = <NRF_PSEL(SPIM_MOSI, 0, 5)>;
    };
  };

  spi3_sleep: spi3_sleep {
    group1 {
      psels = <NRF_PSEL(SPIM_MOSI, 0, 5)>;
      low-power-enable;
    };
  };
};
