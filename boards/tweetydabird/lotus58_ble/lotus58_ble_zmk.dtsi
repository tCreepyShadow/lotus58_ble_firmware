// SPDX-License-Identifier: MIT

// Matrix transform so the keymap works
#include <dt-bindings/zmk/matrix_transform.h>
// Pin control for the RGB LEDs
#include "lotus58_ble-pinctrl.dtsi"

/ {
    chosen {
      zmk,kscan = &kscan0;
      zmk,physical-layout = &default_layout;
      zmk,underglow = &led_strip;
    };

    default_transform: keymap_transform_0 {
      compatible = "zmk,matrix-transform";
      columns = <12>;
      rows = <5>;

      // Switch positions
      // | SW01 | SW02 | SW03 | SW04 | SW05 | SW06 |                      | SW06 | SW05 | SW04 | SW03 | SW02 | SW01 |
      // | SW07 | SW08 | SW09 | SW10 | SW11 | SW12 |                      | SW12 | SW11 | SW10 | SW09 | SW08 | SW07 |
      // | SW13 | SW14 | SW15 | SW16 | SW17 | SW18 |                      | SW18 | SW17 | SW16 | SW15 | SW14 | SW13 |
      // | SW19 | SW20 | SW21 | SW22 | SW23 | SW24 | SW29 |        | SW29 | SW24 | SW23 | SW22 | SW21 | SW20 | SW19 |
      //                      | SW25 | SW26 | SW27 | SW28 |        | SW28 | SW27 | SW26 | SW25 |
      //
      // Switch positions as noted in the PCB file.
      // | SW06 | SW01 | SW02 | SW03 | SW04 | SW05 |                      | SW05 | SW04 | SW03 | SW02 | SW01 | SW06 |
      // | SW11 | SW12 | SW07 | SW08 | SW09 | SW10 |                      | SW10 | SW09 | SW08 | SW07 | SW12 | SW11 |
      // | SW16 | SW17 | SW18 | SW13 | SW14 | SW15 |                      | SW15 | SW14 | SW13 | SW18 | SW17 | SW16 |
      // | SW21 | SW22 | SW23 | SW24 | SW19 | SW20 | SW25 |        | SW25 | SW20 | SW19 | SW24 | SW23 | SW22 | SW21 |
      //                      | SW26 | SW27 | SW28 | SW29 |        | SW29 | SW28 | SW27 | SW26 |

      map = <
      RC(1,2) RC(2,1) RC(3,1) RC(4,1) RC(5,1) RC(0,1)                     RC(0,7)  RC(5,7)  RC(4,7)  RC(3,7)  RC(2,7)  RC(1,8)
      RC(1,3) RC(2,3) RC(3,2) RC(4,2) RC(5,2) RC(0,2)                     RC(0,8)  RC(5,8)  RC(4,8)  RC(3,8)  RC(2,9)  RC(1,9)
      RC(1,4) RC(2,4) RC(3,4) RC(4,3) RC(5,3) RC(0,3)                     RC(0,9)  RC(5,9)  RC(4,9)  RC(3,10) RC(2,10) RC(1,10)
      RC(1,5) RC(2,5) RC(3,5) RC(4,5) RC(5,4) RC(0,4) RC(0,5)    RC(0,11) RC(0,10) RC(5,10) RC(4,11) RC(3,11) RC(2,11) RC(1,11)
                              RC(2,0) RC(3,0) RC(4,0) RC(5,0)    RC(5,6)  RC(4,6)  RC(3,6)  RC(2,6)
      >;
    };

    default_layout: physical_layout_0 {
      compatible = "zmk,physical-layout";
      display-name = "Default Layout";
      transform = <&default_transform>;
    };

    kscan0: kscan0 {
        compatible = "zmk,kscan-gpio-charlieplex";
        wakeup-source;

        // Matrix pin-labels as taken from the schematic.
        // Pin0 = P0.02
        // Pin1 = P0.28
        // Pin2 = P0.03
        // Pin3 = P0.09
        // Pin4 = P0.10
        // Pin5 = P0.24
        // Pin6 = P0.13

        // Pin connections as noted in the schematic.
        // |      |      | Pin1 | Pin2 | Pin3 | Pin4 | Pin5 | Pin0 |
        // |      |      |      |      |      |      |      |      |
        // | Pin6 |      |      | SW01 | SW02 | SW03 | SW04 | SW05 |
        // | Pin6 |      | SW06 |      | SW07 | SW08 | SW09 | SW10 |
        // | Pin6 |      | SW11 | SW12 |      | SW13 | SW14 | SW15 |
        // | Pin6 |      | SW16 | SW17 | SW18 |      | SW19 | SW20 |
        // | Pin6 |      | SW21 | SW22 | SW23 | SW24 |      | SW25 |
        // | Pin6 |      |      | SW26 | SW27 | SW28 | SW29 |      |

        interrupt-gpios = <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
        gpios
          = <&gpio0  2 GPIO_ACTIVE_LOW>
          , <&gpio0 28 GPIO_ACTIVE_LOW>
          , <&gpio0  3 GPIO_ACTIVE_LOW>
          , <&gpio0  9 GPIO_ACTIVE_LOW>
          , <&gpio0 10 GPIO_ACTIVE_LOW>
          , <&gpio0 24 GPIO_ACTIVE_LOW>
          ;
    };

    left_encoder: encoder_left {
      compatible = "alps,ec11";
      a-gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      b-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      steps = <80>;
      status = "disabled";
    };

    right_encoder: encoder_right {
      compatible = "alps,ec11";
      a-gpios = <&gpio1 11 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      b-gpios = <&gpio1 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
      steps = <80>;
      status = "disabled";
    };

    sensors: sensors {
      compatible = "zmk,keymap-sensors";
      sensors = <&left_encoder &right_encoder>;
      triggers-per-rotation = <20>;
    };

    glow_power: glow_power_control {
      compatible = "regulator-fixed";
      regulator-name = "glow-power-control";
      enable-gpios = <&gpio1 9 GPIO_ACTIVE_HIGH>;
      regulator-boot-on;
      regulator-always-on;
    };
};

&spi3 {
  compatible = "nordic,nrf-spim";
  status = "okay";
  pinctrl-0 = <&spi3_default>;
  pinctrl-1 = <&spi3_sleep>;
  pinctrl-names = "default", "sleep";

  // The Lotus58 BLE uses WS2812 compatible SK6812MINI-E LEDs
  led_strip: ws2812@0 {
    compatible = "worldsemi,ws2812-spi";

    reg = <0>;
    spi-max-frequency = <4000000>;

    chain-length = <6>; // Number of LEDs in the (underglow for now) chain
    spi-one-frame = <0x70>;
    spi-zero-frame = <0x40>;
    color-mapping = <
      LED_COLOR_ID_GREEN
      LED_COLOR_ID_RED
      LED_COLOR_ID_BLUE
    >;
  };
};
